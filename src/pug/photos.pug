//- photos.pug
include data/photo-gallery-info.pug

doctype html
html(lang='en')
	include templates/head.pug
	body.photos-page
		include templates/header.pug
		main
			section.header
				h1 Photos
				.lede A collection of images I’ve taken.
			section.photo-grid  
				each img in photoGalleryInfo
					figure.photo 
						img(src=`${img.src}`,
						srcset=`${img.src2x}` + ' 2x',
						alt=`${img.alt}`,
						loading='lazy')
						figcaption #{img.caption}
						a.photo__link(href=`${img.original}`) #{img.caption}
		include templates/footer.pug
